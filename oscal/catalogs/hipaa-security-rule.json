          }
        ]
      },
      {
        "id": "hipaa-164.308-a-7",
        "title": "Contingency plan",
        "props": [
          {
            "name": "label",
            "value": "164.308(a)(7)"
          },
          {
            "name": "citation",
            "ns": "https://github.com/jgage1194/cgep-capstone/ns",
            "value": "45 CFR 164.308(a)(7)"
          },
          {
            "name": "requirement-type",
            "ns": "https://github.com/jgage1194/cgep-capstone/ns",
            "value": "Standard"
          }
        ],
        "links": [
          {
            "href": "https://www.ecfr.gov/current/title-45/section-164.308#p-164.308(a)(7)",
            "rel": "reference",
            "text": "Source regulatory text (eCFR)"
          }
        ],
        "parts": [
          {
            "id": "hipaa-164.308-a-7-statement",
            "name": "statement",
            "prose": "Establish (and implement as needed) policies and procedures for responding to an emergency or other occurrence (for example, fire, vandalism, system failure, and natural disaster) that damages systems that contain electronic protected health information.",
            "parts": [
              {
                "id": "hipaa-164.308-a-7-specifications",
                "name": "item",
                "title": "Implementation specifications — 164.308(a)(7)(ii)",
                "parts": [
                  {
                    "id": "hipaa-164.308-a-7-a",
                    "name": "item",
                    "title": "Data backup plan (Required)",
                    "props": [
                      {
                        "name": "label",
                        "value": "164.308(a)(7)(ii)(A)"
                      }
                    ],
                    "prose": "Establish and implement procedures to create and maintain retrievable exact copies of electronic protected health information."
                  },
                  {
                    "id": "hipaa-164.308-a-7-b",
                    "name": "item",
                    "title": "Disaster recovery plan (Required)",
                    "props": [
                      {
                        "name": "label",
                        "value": "164.308(a)(7)(ii)(B)"
                      }
                    ],
                    "prose": "Establish (and implement as needed) procedures to restore any loss of data."
                  },
                  {
                    "id": "hipaa-164.308-a-7-c",
                    "name": "item",
                    "title": "Emergency mode operation plan (Required)",
                    "props": [
                      {
                        "name": "label",
                        "value": "164.308(a)(7)(ii)(C)"
                      }
                    ],
                    "prose": "Establish (and implement as needed) procedures to enable continuation of critical business processes for protection of the security of electronic protected health information while operating in emergency mode."
                  },
                  {
                    "id": "hipaa-164.308-a-7-d",
                    "name": "item",
                    "title": "Testing and revision procedures (Addressable)",
                    "props": [
                      {
                        "name": "label",
                        "value": "164.308(a)(7)(ii)(D)"
                      }
                    ],
                    "prose": "Implement procedures for periodic testing and revision of contingency plans."
                  },
                  {
                    "id": "hipaa-164.308-a-7-e",
                    "name": "item",
                    "title": "Applications and data criticality analysis (Addressable)",
                    "props": [
                      {
                        "name": "label",
                        "value": "164.308(a)(7)(ii)(E)"
                      }
                    ],
                    "prose": "Assess the relative criticality of specific applications and data in support of other contingency plan components."
                  }
                ]
              }
            ]
          }
        ]
      },
